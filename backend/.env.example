# Copy this file to .env and fill in real values. .env is never committed.

# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Database connection. Defaults to a local SQLite file — no server to
# install or run, just works. Good for local dev.
DATABASE_URL=sqlite:///./sentistock.db

# To switch to Postgres later (recommended before deploying anywhere
# real, since SQLite doesn't handle concurrent writes well): comment
# the line above and uncomment/edit one of these instead.
#
# Local Postgres you installed yourself, or via Docker:
# DATABASE_URL=postgresql+psycopg2://sentistock:sentistock@localhost:5432/sentistock
#
# Free hosted Postgres (e.g. Neon — take their connection string as-is,
# just add "+psycopg2" right after "postgresql"):
# DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxxx.neon.tech/dbname

# Comma-separated list of origins allowed to call this API.
# If you're opening frontend/index.html with a simple static server
# (e.g. `npx serve frontend -l 5500`), that's http://localhost:5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Cache TTLs (seconds) — how long before each endpoint re-fetches from
# Finnhub/yfinance instead of serving the cached Postgres row.
QUOTE_CACHE_SECONDS=30
HISTORY_CACHE_SECONDS=3600
NEWS_CACHE_SECONDS=600

# FinBERT by default. Swap for a smaller/distilled model if CPU
# inference is too slow for your machine.
SENTIMENT_MODEL_NAME=ProsusAI/finbert
